# General
APP_NAME=agent-platform
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent_platform
DATABASE_URL=postgresql+asyncpg://agent:agent@postgres:5432/agent_platform
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0
EVENT_CHANNEL_PREFIX=agent.events

# LLM (Kimi, OpenAI-compatible API)
LLM_API_KEY=sk-replace-me
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_MODEL=kimi-k2.7-code
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_PLAN_MAX_ATTEMPTS=3

# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_API_BASE_URL=https://your-worker.workers.dev/secret-path

# Web auth
JWT_SECRET_KEY=change-me-too
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
WEB_ALLOWED_ORIGINS=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# Sandbox and storage
WORKSPACES_ROOT=/data/workspaces
ARTIFACTS_ROOT=/data/artifacts
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_NETWORK_MODE=none
SANDBOX_WORKDIR=/workspace
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_TMPFS_SIZE_MB=64
SANDBOX_IDLE_TIMEOUT_SECONDS=1800

# Agent tools
SHELL_TIMEOUT_SECONDS=120
SHELL_MAX_OUTPUT_BYTES=262144
SHELL_APPROVAL_MODE=dangerous
HTTP_ALLOWED_HOSTS=api.github.com,raw.githubusercontent.com,pypi.org,files.pythonhosted.org
HTTP_REQUEST_TIMEOUT_SECONDS=30
HTTP_MAX_RESPONSE_BYTES=1048576
MAX_STEPS_PER_TASK=20
STEP_MAX_ATTEMPTS=2
APPROVAL_TTL_SECONDS=1800
ARTIFACT_MAX_BYTES=52428800

# Workers
WORKER_MAX_JOBS=4
WORKER_JOB_TIMEOUT_SECONDS=900
WORKER_KEEP_RESULT_SECONDS=3600

# Frontend public endpoints (docker-compose build args)
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8000
